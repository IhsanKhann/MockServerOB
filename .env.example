PORT=
PHP_PARTNER_API_KEY=
BACKEND_ORIGIN=
MONGO_URI=

# ── Tier-2 REST fallback poller (GET /api/sync/events on ERP Core) ─────────
# ERP_BASE_URL: ERP Core's origin, e.g. http://localhost:5000
# TIER2_INBOUND_API_KEY / TIER2_INBOUND_API_SECRET: an "inbound"-direction
#   B2BCredential ERP Core issued (see scripts/seedConnectedSystemCredentials.js
#   in the Backend-offerB repo) — the same credential class used for
#   POST /api/sync/event, not a new auth mechanism.
ERP_BASE_URL=
TIER2_INBOUND_API_KEY=
TIER2_INBOUND_API_SECRET=
TIER2_POLL_ENABLED=false
TIER2_POLL_INTERVAL_MS=5000
TIER2_POLL_LIMIT=50

# ── Fault injection (/api/v2/* only — never /api/mock/*) ────────────────────
# Both default to disabled so dev.offerberriesvo.com stays usable day-to-day.
# See docs/SCENARIOS.md. Bypass per-request with x-mock-bypass-fault: true.
FAULT_LATENCY_ENABLED=false
FAULT_LATENCY_MIN_MS=0
FAULT_LATENCY_MAX_MS=0
FAULT_ERROR_ENABLED=false
FAULT_ERROR_RATE=0
FAULT_ERROR_STATUS=500